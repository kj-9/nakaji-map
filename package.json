{
	"name": "nakaji-map",
	"version": "0.3.6",
	"scripts": {
		"preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) throw new Error('Use pnpm to install dependencies')\"",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "pnpm test:unit && pnpm test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"verify": "pnpm format && pnpm check && pnpm lint",
		"test:integration": "playwright test",
		"test:unit": "vitest run"
	},
	"keywords": [],
	"author": "kj-9",
	"license": "ISC",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@protomaps/basemaps": "^5.7.2",
		"@types/geojson": "^7946.0.16",
		"maplibre-gl": "^6.14.0",
		"pmtiles": "^4.5.0",
		"svelte-maplibre-gl": "^2.2.1"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": "^24.22.0",
		"pnpm": "12.14.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
