{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*.ts", "*.js"],
	"exclude": ["src/service-worker", "node_modules", "build"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}
